# 统一换行：仓库内一律 LF，避免 Windows 检出后产生整文件 diff
* text=auto eol=lf

# 明确按文本处理的文件
*.py   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# 二进制（永不做换行/合并转换）
*.db     binary
*.db-wal binary
*.db-shm binary
*.png    binary
*.jpg    binary
*.gif    binary
*.exe    binary
*.zip    binary

# 语言与生成统计
*.py linguist-language=Python
